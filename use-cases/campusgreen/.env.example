# Copy this file to a local `.env` (or export the variables) and fill in real
# values. No real secrets belong in the repository — see INTEGRATION.md.
#
# LLM credentials
OPENAI_API_KEY=

# Optional: run the same agent against Groq (chat-completions only, no Responses API).
# When GROQ_API_KEY is set, agent.py builds an explicit OpenAIChatCompletionsModel
# pointed at Groq. GROQ_MODEL defaults to llama-3.3-70b-versatile. Otherwise the
# OpenAI path above is used unchanged.
GROQ_API_KEY=
GROQ_MODEL=

# Telegram Bot API credentials
# (used by server.py; the local integration_demo.py runs without these)
TELEGRAM_BOT_TOKEN=
# AK_TELEGRAM__BOT_TOKEN=

# Optional: label issues created through the Telegram surface
# (defaults to "cli" for the local demo)
CAMPUSGREEN_CHANNEL=telegram

# Optional: point the local data layer elsewhere (tests use this)
# CAMPUSGREEN_DATA_DIR=/tmp/campusgreen-data
