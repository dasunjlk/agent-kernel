# Copy this file to a local `.env` (or export the variables) and fill in real
# values. No real secrets belong in the repository — see INTEGRATION.md.
#
# LLM credentials
OPENAI_API_KEY=

# WhatsApp / Meta Cloud API credentials
# (used by server.py; the local integration_demo.py runs without these)
AK_WHATSAPP__ACCESS_TOKEN=
AK_WHATSAPP__PHONE_NUMBER_ID=
AK_WHATSAPP__VERIFY_TOKEN=
AK_WHATSAPP__APP_SECRET=

# Optional: label issues created through the WhatsApp surface
# (defaults to "cli" for the local demo)
CAMPUSGREEN_CHANNEL=whatsapp

# Optional: point the local data layer elsewhere (tests use this)
# CAMPUSGREEN_DATA_DIR=/tmp/campusgreen-data
